# Copy this file to `.env.local` and fill in your keys.
# These are read ONLY on the server (Next.js route handlers) and are never sent to the browser.
# Leave the key empty and the app falls back to bundled demo news.

# https://newsapi.org/register
NEWS_API_KEY=

# Force demo data for every source (used by the E2E tests). Optional.
USE_MOCK_DATA=false
